# Copy this file to .env and fill in your own keys. Never commit .env.
# Groq (LLM): https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Tavily (web search, optional): https://app.tavily.com
# Without it the app searches DuckDuckGo (no key needed); if that also fails it uses labelled sample data.
TAVILY_API_KEY=your-tavily-api-key-here

# Set to 1 to skip web search and use clearly labelled sample data (still needs the LLM key above).
USE_SAMPLE_DATA=0

# Model used by all four roles
GROQ_MODEL=openai/gpt-oss-120b
# Model used by the evaluator (judge). Use a different model if you can.
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# Optional tracing with Opik (leave empty to disable)
OPIK_API_KEY=
OPIK_WORKSPACE=
